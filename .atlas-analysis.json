  "keyFeatures": [
    "OpenChat bot registration and initialization",
    "Join groups, communities, and channels with invite codes",
    "Send and edit messages in groups and channels",
    "Track NNS governance proposals with TallyBot",
    "Monitor and broadcast proposal updates with ProposalBot",
    "Subscription management for tally updates",
    "Avatar and display name configuration",
    "Comprehensive logging and metrics",
    "Custodian-based access control"
  ],
  "publicApiSurface": [
    "BotService.initBot",
    "BotService.setAvatar",
    "BotService.joinGroup",
    "BotService.joinCommunity",
    "BotService.joinChannel",
    "BotService.sendGroupMessage",
    "BotService.sendChannelMessage",
    "BotService.editGroupMessage",
    "BotService.editChannelMessage",
    "TallyBot.addSubscriber",
    "TallyBot.deleteSubscription",
    "TallyBot.getSubscribers",
    "TallyBot.tallyUpdate",
    "ProposalBot.initTimer",
    "ProposalBot.cancelTimer",
    "ProposalBot.addSubscriber",
    "ProposalBot.deleteSubscriber",
    "ProposalBot.updateSubscriber",
    "OCService.registerBot",
    "OCService.userSummary",
    "OCService.publicGroupSummary",
    "OCService.publicCommunitySummary",
    "LogService.getLogs",
    "LogService.clearLogs",
    "getCanisterStatus"
  ]
